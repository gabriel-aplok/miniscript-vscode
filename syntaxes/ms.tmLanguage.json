{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "miniscript",
  "scopeName": "source.ms",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#functions" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.ms",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.ms",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ms",
          "match": "\\\\."
        },
        {
          "name": "meta.interpolation.ms",
          "begin": "\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.interpolation.begin.ms" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.interpolation.end.ms" }
          },
          "patterns": [{ "include": "$self" }]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ms",
          "match": "\\b(if|else|while|for|in|return|try|catch|finally|throw|import)\\b"
        },
        {
          "name": "storage.type.var.ms",
          "match": "\\bvar\\b"
        },
        {
          "name": "storage.type.function.ms",
          "match": "\\bfunc\\b"
        },
        {
          "name": "keyword.operator.logical.ms",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(print|clock|input|math|string|os|io)\\b",
          "name": "support.function.builtin.ms"
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\()",
          "name": "entity.name.function.ms"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.ms",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.ms",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.ms",
          "match": "(\\+|\\-|\\*|/|%|)=|="
        },
        {
          "name": "keyword.operator.comparison.ms",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.ms",
          "match": "\\+|\\-|\\*|/|%"
        }
      ]
    }
  }
}
